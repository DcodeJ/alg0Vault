<Window x:Class="AlgorithmVault.PracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AlgorithmVault.Controls"
        Title="Interview Practice — alg0Vault" Icon="Assets/alg0vault.ico" Height="820" Width="1180" MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackground}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#080C18"/><SolidColorBrush x:Key="TopBarBackground" Color="#0D1323"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#0D1424"/><SolidColorBrush x:Key="DetailBackground" Color="#090E1B"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#0D1425"/><SolidColorBrush x:Key="PopupBackground" Color="#182238"/>
        <SolidColorBrush x:Key="ButtonSurface" Color="#202A41"/><SolidColorBrush x:Key="CardBackground" Color="#121B2E"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#172137"/><SolidColorBrush x:Key="SelectionBackground" Color="#211F3E"/>
        <SolidColorBrush x:Key="CodeBackground" Color="#080D18"/><SolidColorBrush x:Key="CodeGutter" Color="#0D1422"/>
        <SolidColorBrush x:Key="SectionText" Color="#71809B"/><SolidColorBrush x:Key="Surface" Color="#101729"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#172039"/><SolidColorBrush x:Key="Border" Color="#25314A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7F8FC"/><SolidColorBrush x:Key="TextSecondary" Color="#9AA8BF"/>
        <SolidColorBrush x:Key="Accent" Color="#7164F4"/><SolidColorBrush x:Key="AccentSoft" Color="#292650"/><SolidColorBrush x:Key="Mint" Color="#35D0AA"/>

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SectionText}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PracticeButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.84"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PracticeButton}"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource ButtonSurface}"/></Style>
        <Style x:Key="PracticeCombo" TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource FieldBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#172033"/><Setter Property="Padding" Value="8,6"/></Style>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource TopBarBackground}" CornerRadius="9,9,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="22,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="{DynamicResource Accent}" CornerRadius="9"><TextBlock Text="⚡" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="12,0,0,0"><TextBlock Text="INTERVIEW PRACTICE" Foreground="{DynamicResource Mint}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Think first. Reveal second. Track progress." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="12,6" Margin="0,0,10,0"><TextBlock x:Name="SessionText" Text="0 reviewed this session" Foreground="{DynamicResource TextSecondary}" FontSize="11"/></Border>
                        <Button Content="—" Style="{StaticResource SecondaryButton}" Click="Minimize_Click" Width="40" Padding="8"/>
                        <Button Content="×" Style="{StaticResource SecondaryButton}" Click="Close_Click" Width="40" Padding="8" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,9">
                    <StackPanel Margin="22,26">
                        <TextBlock Text="PRACTICE SETUP" Style="{StaticResource Label}"/>
                        <TextBlock Text="Build recall, not recognition" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <TextBlock Text="Choose a pool, solve aloud, then grade your confidence honestly." Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,22"/>
                        <TextBlock Text="DIFFICULTY" Style="{StaticResource Label}" Margin="1,0,0,7"/>
                        <ComboBox x:Name="DifficultyPicker" Style="{StaticResource PracticeCombo}" SelectedIndex="0"><ComboBoxItem Content="Any difficulty"/><ComboBoxItem Content="Easy"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Hard"/></ComboBox>
                        <TextBlock Text="CATEGORY" Style="{StaticResource Label}" Margin="1,18,0,7"/>
                        <ComboBox x:Name="CategoryPicker" Style="{StaticResource PracticeCombo}" SelectedIndex="0"/>
                        <TextBlock Text="MASTERY" Style="{StaticResource Label}" Margin="1,18,0,7"/>
                        <ComboBox x:Name="MasteryPicker" Style="{StaticResource PracticeCombo}" SelectedIndex="0"><ComboBoxItem Content="Any mastery"/><ComboBoxItem Content="New"/><ComboBoxItem Content="Learning"/><ComboBoxItem Content="Confident"/><ComboBoxItem Content="Mastered"/></ComboBox>
                        <Button Content="Generate challenge" Click="NextChallenge_Click" Style="{StaticResource PracticeButton}" Margin="0,22,0,0"/>
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="YOUR PROGRESS" Style="{StaticResource Label}"/>
                                <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock x:Name="MasteredCountText" Text="0" Foreground="{DynamicResource Mint}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="MASTERED" Style="{StaticResource Label}" FontSize="8"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock x:Name="ReviewedCountText" Text="0" Foreground="{DynamicResource Accent}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="REVIEWS" Style="{StaticResource Label}" FontSize="8"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Tip: explain the brute-force approach before optimizing. Interviewers value your reasoning." Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="2,18,2,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="38,32,42,42" MaxWidth="960" HorizontalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="15" Padding="26">
                            <StackPanel>
                                <DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,5"><TextBlock x:Name="MasteryBadge" Text="NEW" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/></Border><TextBlock Text="TODAY'S CHALLENGE" Foreground="{DynamicResource Mint}" FontSize="10" FontWeight="Bold"/></DockPanel>
                                <TextBlock x:Name="ChallengeTitle" Text="Choose your filters and generate a challenge" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,13,0,0"><Border Background="{DynamicResource FieldBackground}" CornerRadius="6" Padding="9,4"><TextBlock x:Name="CategoryText" Text="Interview preparation" Foreground="{DynamicResource TextSecondary}" FontSize="10"/></Border><Border Background="{DynamicResource FieldBackground}" CornerRadius="6" Padding="9,4" Margin="8,0,0,0"><TextBlock x:Name="DifficultyText" Text="Focused practice" Foreground="{DynamicResource TextSecondary}" FontSize="10"/></Border></StackPanel>
                                <TextBlock Text="PROBLEM BRIEF" Style="{StaticResource Label}" Margin="0,26,0,8"/>
                                <TextBlock x:Name="SummaryText" Text="A random algorithm from your library will appear here. Explain the approach, analyze complexity, identify edge cases, and write the C# solution before revealing it." Foreground="{DynamicResource TextPrimary}" FontSize="15" LineHeight="24" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,22,0,0">
                                    <StackPanel><TextBlock Text="INTERVIEW CHECKLIST" Style="{StaticResource Label}"/><TextBlock Text="1. Clarify inputs and constraints   •   2. State brute force   •   3. Derive the optimal pattern   •   4. Analyze time and space   •   5. Test edge cases" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                                </Border>
                                <Button x:Name="RevealButton" Content="Reveal solution" Click="Reveal_Click" Style="{StaticResource PracticeButton}" HorizontalAlignment="Left" MinWidth="160" Margin="0,22,0,0" IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SolutionPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,22,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="PATTERN" Style="{StaticResource Label}"/><TextBlock x:Name="PatternText" Text="—" Margin="0,7,0,0" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="6,0"><StackPanel><TextBlock Text="TIME" Style="{StaticResource Label}"/><TextBlock x:Name="TimeText" Text="—" Margin="0,7,0,0" FontFamily="Consolas" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="SPACE" Style="{StaticResource Label}"/><TextBlock x:Name="SpaceText" Text="—" Margin="0,7,0,0" FontFamily="Consolas" FontWeight="SemiBold"/></StackPanel></Border>
                            </Grid>
                            <TextBlock Text="REFERENCE SOLUTION" Style="{StaticResource Label}" Margin="1,20,0,8"/>
                            <Border Background="{DynamicResource CodeBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12"><controls:CSharpCodeEditor x:Name="SolutionEditor" IsReadOnly="True" MinHeight="250" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Code, Consolas" FontSize="13" Padding="20"/></Border>
                            <TextBlock Text="NOTES &amp; EDGE CASES" Style="{StaticResource Label}" Margin="1,20,0,8"/>
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="16"><TextBlock x:Name="NotesText" Text="—" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></Border>
                        </StackPanel>

                        <Border x:Name="GradePanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,18,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="HOW DID IT GO?" Style="{StaticResource Label}"/><TextBlock Text="Your rating updates mastery and review history locally." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Need review" Tag="Learning" Click="Grade_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Got it" Tag="Confident" Click="Grade_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/><Button Content="Mastered" Tag="Mastered" Click="Grade_Click" Style="{StaticResource PracticeButton}" Margin="8,0,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
