<Window x:Class="AlgorithmVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AlgorithmVault.Controls"
        Title="alg0Vault" Icon="Assets/alg0vault.ico" Height="900" Width="1480" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#080C18" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#080C18"/>
        <SolidColorBrush x:Key="TopBarBackground" Color="#0D1323"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#0D1424"/>
        <SolidColorBrush x:Key="LibraryBackground" Color="#101729"/>
        <SolidColorBrush x:Key="DetailBackground" Color="#090E1B"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#0D1425"/>
        <SolidColorBrush x:Key="PopupBackground" Color="#182238"/>
        <SolidColorBrush x:Key="ButtonSurface" Color="#202A41"/>
        <SolidColorBrush x:Key="CardBackground" Color="#121B2E"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#172137"/>
        <SolidColorBrush x:Key="SelectionBackground" Color="#211F3E"/>
        <SolidColorBrush x:Key="CodeBackground" Color="#080D18"/>
        <SolidColorBrush x:Key="CodeGutter" Color="#0D1422"/>
        <SolidColorBrush x:Key="SectionText" Color="#71809B"/>
        <SolidColorBrush x:Key="Surface" Color="#101729"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#172039"/>
        <SolidColorBrush x:Key="Border" Color="#25314A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7F8FC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA8BF"/>
        <SolidColorBrush x:Key="Accent" Color="#7164F4"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#292650"/>
        <SolidColorBrush x:Key="Mint" Color="#35D0AA"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SectionText}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#8175FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#5F52D9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ButtonSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboField" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                            <ToggleButton x:Name="MainToggle" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ToggleButton x:Name="ArrowToggle" Width="34" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Focusable="False" Visibility="Collapsed" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#77869F" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" CaretBrush="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Padding="10,7" Margin="0,0,34,0" VerticalContentAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            <Trigger Property="IsEditable" Value="True"><Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="MainToggle" Property="Visibility" Value="Collapsed"/><Setter TargetName="ArrowToggle" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Background="#3B4963"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbRoot" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#596984"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8"/><Setter Property="Width" Value="Auto"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource AppBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="{DynamicResource TopBarBackground}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoft}">
                        <Image Source="Assets/alg0vault.ico" Margin="2" Stretch="Uniform" AutomationProperties.Name="Robot app icon"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="alg0VAULT" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Algorithms + semester notes" Style="{StaticResource Caption}" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Mint}" Margin="0,0,7,0"/>
                            <TextBlock Text="Saved locally" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Theme" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="ThemeSelector" Style="{StaticResource ComboField}" Width="116" Padding="10,6" FontSize="11" SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Content="Current"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Purple"/><ComboBoxItem Content="White"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click" Width="43"/>
                    <Button Content="□" Style="{StaticResource IconButton}" Click="Maximize_Click" Width="43"/>
                    <Button Content="×" Style="{StaticResource IconButton}" Click="Close_Click" Width="43" FontSize="21"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="372"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0">
                    <Grid Margin="18,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Button Content="＋  New algorithm" Style="{StaticResource PrimaryButton}" Click="AddAlgorithm_Click" HorizontalAlignment="Stretch"/>
                            <Button x:Name="NewNoteThreadButton" Content="＋  New note thread" Style="{StaticResource SecondaryButton}" Click="NewNoteThread_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="2,28,2,0">
                            <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="8,0,0,10"/>
                            <Button x:Name="AllButton" Click="ShowAll_Click" HorizontalContentAlignment="Left" Style="{StaticResource IconButton}" Margin="0,2" Padding="12,10">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="▦" Style="{StaticResource NavText}" FontSize="16" Margin="0,0,11,0"/>
                                    <TextBlock Text="All algorithms" Style="{StaticResource NavText}" FontSize="13" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Background="#32285A" CornerRadius="8" Padding="7,2">
                                        <TextBlock x:Name="TotalCountText" Text="0" Style="{StaticResource NavText}" FontSize="10"/>
                                    </Border>
                                </DockPanel>
                            </Button>
                            <Button x:Name="FavoritesButton" Click="ShowFavorites_Click" HorizontalContentAlignment="Left" Style="{StaticResource IconButton}" Margin="0,2" Padding="12,10">
                                <DockPanel><TextBlock Text="★" Foreground="#F7C95E" FontSize="15" Margin="0,0,11,0"/><TextBlock Text="Favorites" Style="{StaticResource NavText}" FontSize="13" VerticalAlignment="Center"/></DockPanel>
                            </Button>
                            <Button x:Name="CoreButton" Click="ShowCore_Click" HorizontalContentAlignment="Left" Style="{StaticResource IconButton}" Margin="0,2" Padding="12,10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="◆" Foreground="{DynamicResource Mint}" FontSize="12" Margin="1,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="Core collection" Style="{StaticResource NavText}" FontSize="13" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#173B3A" CornerRadius="8" Padding="7,2"><TextBlock x:Name="CoreCountText" Text="0" Foreground="#65E0C1" FontSize="10"/></Border>
                                </Grid>
                            </Button>
                            <Button x:Name="NotesHubButton" Click="ShowNotesHub_Click" HorizontalContentAlignment="Left" Style="{StaticResource IconButton}" Margin="0,8,0,2" Padding="12,10">
                                <DockPanel><TextBlock Text="▤" Style="{StaticResource NavText}" FontSize="15" Margin="0,0,11,0"/><TextBlock Text="Notes Hub" Style="{StaticResource NavText}" FontSize="13" VerticalAlignment="Center"/></DockPanel>
                            </Button>
                            <Button Click="OpenPractice_Click" HorizontalContentAlignment="Left" Style="{StaticResource IconButton}" Margin="0,2" Padding="12,10">
                                <DockPanel><TextBlock Text="⚡" Foreground="#F7C95E" FontSize="15" Margin="0,0,11,0"/><TextBlock Text="Interview Practice" Style="{StaticResource NavText}" FontSize="13" VerticalAlignment="Center"/></DockPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="2,30,2,0">
                            <TextBlock Text="CATEGORIES" Style="{StaticResource SectionLabel}" Margin="8,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding CategoryStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Name}" Click="Category_Click" HorizontalContentAlignment="Stretch" Style="{StaticResource IconButton}" Margin="0,1" Padding="12,8">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,11,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#667590" FontSize="11" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="LibraryStatText" Text="0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="TOTAL" Style="{StaticResource SectionLabel}" FontSize="8"/></StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock x:Name="MasteredCountText" Text="0" Foreground="{DynamicResource Mint}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="MASTERED" Style="{StaticResource SectionLabel}" FontSize="8"/></StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock x:Name="FavoriteCountText" Text="0" Foreground="#F7C95E" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="STARRED" Style="{StaticResource SectionLabel}" FontSize="8"/></StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center"><TextBlock x:Name="HardCountText" Text="0" Foreground="#F195A2" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="HARD" Style="{StaticResource SectionLabel}" FontSize="8"/></StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⇧ Export" Click="Export_Click" Style="{StaticResource IconButton}" FontSize="11" Padding="9,7"/>
                                <Button Content="⇩ Import" Click="Import_Click" Style="{StaticResource IconButton}" FontSize="11" Padding="9,7"/>
                            </StackPanel>
                            <TextBlock x:Name="DataPathText" Text="Local JSON storage" Style="{StaticResource Caption}" FontSize="9" Margin="9,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Search and algorithm list -->
                <Border x:Name="AlgorithmListPane" Grid.Column="1" Background="{DynamicResource LibraryBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="22,23,22,14">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LibraryTitleText" Text="All algorithms" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ResultCountText" Grid.Column="1" Text="0 items" Style="{StaticResource Caption}" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="⌕" FontSize="19" Foreground="#72819C" Margin="13,0,0,0" VerticalAlignment="Center" Panel.ZIndex="2" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="40,10,12,10" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock Text="Search algorithms, patterns, tags..." Foreground="#61708B" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <ComboBox x:Name="DifficultyFilter" Style="{StaticResource ComboField}" Width="130" SelectionChanged="Filter_Changed" SelectedIndex="0">
                                    <ComboBoxItem Content="Any difficulty"/><ComboBoxItem Content="Easy"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Hard"/>
                                </ComboBox>
                                <ComboBox x:Name="SortFilter" Style="{StaticResource ComboField}" Width="142" Margin="8,0,0,0" SelectionChanged="Filter_Changed" SelectedIndex="0">
                                <ComboBoxItem Content="Recently edited"/><ComboBoxItem Content="Title A–Z"/><ComboBoxItem Content="Difficulty"/><ComboBoxItem Content="Category"/><ComboBoxItem Content="Pattern"/><ComboBoxItem Content="Mastery progress"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <ListBox Grid.Row="1" x:Name="AlgorithmList" ItemsSource="{Binding FilteredAlgorithms}" SelectedItem="{Binding SelectedAlgorithm, Mode=TwoWay}" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="10,0,10,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="14,13">
                                                    <Grid>
                                                        <Border x:Name="SelectionMark" Width="3" Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0" Visibility="Collapsed"/>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource AccentSoft}"/><Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/></Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                                                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SelectionBackground}"/></MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <TextBlock Text="◆" Foreground="{DynamicResource Mint}" FontSize="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="★" Foreground="#F7C95E" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <Border Background="#1C2B3E" CornerRadius="5" Padding="7,3" Margin="0,0,6,0"><TextBlock Text="{Binding Category}" Foreground="#8CC8EE" FontSize="9"/></Border>
                                                <Border CornerRadius="5" Padding="7,3" Margin="0,0,6,0">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#302A20"/><Style.Triggers><DataTrigger Binding="{Binding Difficulty}" Value="Easy"><Setter Property="Background" Value="#17372F"/></DataTrigger><DataTrigger Binding="{Binding Difficulty}" Value="Hard"><Setter Property="Background" Value="#40242F"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="{Binding Difficulty}" FontSize="9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EFC66B"/><Style.Triggers><DataTrigger Binding="{Binding Difficulty}" Value="Easy"><Setter Property="Foreground" Value="#62D6B2"/></DataTrigger><DataTrigger Binding="{Binding Difficulty}" Value="Hard"><Setter Property="Foreground" Value="#F39BAA"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                </Border>
                                                <Border Background="#1D283D" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding TimeComplexity}" Foreground="#9AA9C2" FontFamily="Consolas" FontSize="9"/></Border>
                                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="7,3" Margin="6,0,0,0"><TextBlock Text="{Binding MasteryLevel}" Foreground="{DynamicResource Accent}" FontSize="9"/></Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Pattern}" Foreground="#7D89A0" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,10,0"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,10,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" BorderBrush="#202B43" BorderThickness="0,1,0,0" Padding="22,12">
                            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Caption}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Detail editor -->
                <Border x:Name="AlgorithmDetailPane" Grid.Column="2" Background="{DynamicResource DetailBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="34,28,36,34" IsEnabled="{Binding HasSelection}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="FavoriteButton" Content="☆" Click="Favorite_Click" Style="{StaticResource SecondaryButton}" Padding="13,8" FontSize="18" ToolTip="Toggle favorite"/>
                                    <Button Content="Delete" Click="Delete_Click" Style="{StaticResource SecondaryButton}" Foreground="#F39AA1" Margin="8,0,0,0" Padding="14,8"/>
                                    <Button Content="Save changes" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="16,8"/>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ALGORITHM DETAILS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                        <Border Background="#173B3A" CornerRadius="6" Padding="7,3" Margin="10,0,0,0">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedAlgorithm.IsBuiltIn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="◆  CORE" Foreground="#65E0C1" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Text="{Binding SelectedAlgorithm.Title, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" FontSize="28" FontWeight="SemiBold" Padding="0" Margin="0,7,20,0"/>
                                    <TextBlock x:Name="UpdatedText" Text="Select an algorithm to begin" Style="{StaticResource Caption}" Margin="1,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,28,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="CATEGORY" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <ComboBox Style="{StaticResource ComboField}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedAlgorithm.Category, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="DIFFICULTY" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <ComboBox Style="{StaticResource ComboField}" SelectedValue="{Binding SelectedAlgorithm.Difficulty, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="Easy"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Hard"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="MASTERY" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <ComboBox Style="{StaticResource ComboField}" SelectedValue="{Binding SelectedAlgorithm.MasteryLevel, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="New"/><ComboBoxItem Content="Learning"/><ComboBoxItem Content="Confident"/><ComboBoxItem Content="Mastered"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                    <TextBlock Text="TIME" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <ComboBox Style="{StaticResource ComboField}" IsEditable="True" StaysOpenOnEdit="True" ItemsSource="{Binding ComplexityOptions}" Text="{Binding SelectedAlgorithm.TimeComplexity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="SPACE" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <ComboBox Style="{StaticResource ComboField}" IsEditable="True" StaysOpenOnEdit="True" ItemsSource="{Binding ComplexityOptions}" Text="{Binding SelectedAlgorithm.SpaceComplexity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Margin="0,24,0,0">
                                <TextBlock Text="SUMMARY" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                <TextBox Text="{Binding SelectedAlgorithm.Summary, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalContentAlignment="Top"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,22,0,0">
                                <DockPanel Margin="1,0,1,7">
                                    <TextBlock Text="C# IMPLEMENTATION" Style="{StaticResource SectionLabel}"/>
                                    <Button DockPanel.Dock="Right" Content="Copy code" Click="CopyCode_Click" Style="{StaticResource IconButton}" FontSize="10" Padding="8,3"/>
                                </DockPanel>
                                <Border Background="{DynamicResource CodeBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11">
                                    <Grid>
                                        <Border Width="42" HorizontalAlignment="Left" Background="{DynamicResource CodeGutter}" CornerRadius="10,0,0,10"/>
                                        <controls:CSharpCodeEditor x:Name="CodeEditor" Code="{Binding SelectedAlgorithm.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Code, Consolas" FontSize="13" MinHeight="270" Padding="55,18,18,18"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="4" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2.4*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="PATTERN" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <TextBox Text="{Binding SelectedAlgorithm.Pattern, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="TAGS" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <TextBox Text="{Binding SelectedAlgorithm.Tags, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" ToolTip="Comma-separated tags"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="LEARNING NOTES &amp; EDGE CASES" Style="{StaticResource SectionLabel}" Margin="1,0,0,7"/>
                                    <TextBox Text="{Binding SelectedAlgorithm.Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="5" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,24,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tip: Ctrl+S save  •  Ctrl+N new  •  Ctrl+F search" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="1" Text="100% local  •  JSON backed" Foreground="#6F7E98" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
                <controls:NotesHubView x:Name="NotesHub" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
